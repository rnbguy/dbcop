# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Keep Cargo.lock tracked for reproducible CLI, FFI, and benchmark builds.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# wasmbuild artifacts
wasmlib/

# Sisyphus and OMC directories
.sisyphus/
.omc/
.claude/

# npm/node artifacts (husky install)
node_modules/

# Coverage artifacts
coverage/

# Go mockserver artifacts
mockserver/mockserver
